<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Multi-Step Form</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f0f4f8;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }

    .container {
      display: flex;
      background-color: white;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
      width: 800px;
      overflow: hidden;
    }

    .steps {
      background-color: #003366;
      color: white;
      padding: 20px;
      margin-bottom: 20px;
      opacity: 0.6;
    }

    .step.active {
      opacity: 1;
      font-weight: bold;
    }

    .step span {
      display: inline-block;
      width: 30px;
      height: 30px;
      background-color: #00509E;
      border-radius: 50%;
      text-align: center;
      line-height: 30px;
      font-weight: bold;
      margin-right: 10px;
    }

    .form-container {
      padding: 30px;
      flex-grow: 1;
    }

    .form-step {
      display: none;
    }

    .form-step.active {
      display: block;
    }

    .form-group {
      margin-bottom: 15px;
    }

    .form-group label {
      display: block;
      margin-bottom: 5px;
      font-weight: bold;
    }

    .form-group input {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 5px;
    }

    .buttons {
      margin-top: 20px;
      display: flex;
      justify-content: space-between;
    }

    button {
      background-color: #003366;
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    button:hover {
      background-color: #00509E;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="steps">
      <div class="step active" id="step-1"><span>1</span> YOUR INFO</div>
      <div class="step" id="step-2"><span>2</span> SELECT PLAN</div>
      <div class="step" id="step-3"><span>3</span> ADD-ONS</div>
      <div class="step" id="step-4"><span>4</span> SUMMARY</div>
    </div>
    <div class="form-container">
      <!-- Step 1 -->
      <div class="form-step active" id="form-step-1">
        <h2>Personal info</h2>
        <p>Please provide your name, email address, and phone number.</p>
        <div class="form-group">
          <label>Name</label>
          <input type="text" placeholder="e.g. Stephen King" />
        </div>
        <div class="form-group">
          <label>Email Address</label>
          <input type="email" placeholder="e.g. stephenking@lorem.com" />
        </div>
        <div class="form-group">
          <label>Phone Number</label>
          <input type="tel" placeholder="e.g. +1 234 567 890" />
        </div>
        <div class="buttons">
          <span></span>
          <button onclick="nextStep()">Next Step</button>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="form-step" id="form-step-2">
        <h2>Select Plan</h2>
        <p>Choose your subscription plan.</p>
        <div class="form-group">
          <label><input type="radio" name="plan" /> Basic Plan</label>
          <label><input type="radio" name="plan" /> Premium Plan</label>
          <label><input type="radio" name="plan" /> Pro Plan</label>
        </div>
        <div class="buttons">
          <button onclick="prevStep()">Go Back</button>
          <button onclick="nextStep()">Next Step</button>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="form-step" id="form-step-3">
        <h2>Add-Ons</h2>
        <p>Select additional features.</p>
        <div class="form-group">
          <label><input type="checkbox" /> Extra Storage</label>
          <label><input type="checkbox" /> Priority Support</label>
          <label><input type="checkbox" /> Custom Reports</label>
        </div>
        <div class="buttons">
          <button onclick="prevStep()">Go Back</button>
          <button onclick="nextStep()">Next Step</button>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="form-step" id="form-step-4">
        <h2>Summary</h2>
        <p>Review your selections before submitting.</p>
        <ul>
          <li><strong>Name:</strong> Stephen King</li>
          <li><strong>Email:</strong> stephenking@lorem.com</li>
          <li><strong>Phone:</strong> +1 234 567 890</li>
          <li><strong>Plan:</strong> Premium</li>
          <li><strong>Add-Ons:</strong> Extra Storage, Priority Support</li>
        </ul>
        <div class="buttons">
          <button onclick="prevStep()">Go Back</button>
          <button onclick="alert('Form submitted!')">Submit</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentStep = 1;

    function showStep(step) {
      document.querySelectorAll('.form-step').forEach((el, index) => {
        el.classList.toggle('active', index === step - 1);
      });
      document.querySelectorAll('.step').forEach((el, index) => {
        el.classList.toggle('active', index === step - 1);
      });
    }

    function nextStep() {
      if (currentStep < 4) {
        currentStep++;
        showStep(currentStep);
      }
    }

    function prevStep() {
      if (currentStep > 1) {
        currentStep--;
        showStep(currentStep);
      }
    }
  </script>
</body>
</html>

